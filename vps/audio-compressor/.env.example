# Copiar a .env EN EL VPS (/root/audio-compressor/.env). No commitear secretos.
PORT=8723
# Token compartido con la edge function (Supabase secret AUDIO_COMPRESSOR_TOKEN).
COMPRESSOR_TOKEN=cambiar-por-token-largo-aleatorio
# Bitrate opus. 12k cubre ~3.7h en <20MB. Subí a 16k/24k si querés más calidad.
BITRATE=12k
MAX_INPUT_MB=300
