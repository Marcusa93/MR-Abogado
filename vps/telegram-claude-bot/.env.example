# Copiá a .env y completá EN EL VPS (/root/telegram-claude-bot/.env).
# NUNCA pongas secretos reales en este archivo (.env.example está versionado).
TELEGRAM_BOT_TOKEN=123456:ABC-tu-token-de-BotFather
# Tu chat id NUMÉRICO (no tu @usuario). Te lo da @userinfobot. Coma para varios.
ALLOWED_CHAT_IDS=123456789
# Autenticación de Claude Code (motor del bot). Una de estas dos:
#  a) CLAUDE_CODE_OAUTH_TOKEN=...  (token de `claude setup-token`, tu suscripción)
#  b) ANTHROPIC_API_KEY=sk-ant-api...  (API key de console.anthropic.com)
# OpenRouter NO sirve para Claude Code; es solo para las features de la app.
# CLAUDE_CODE_OAUTH_TOKEN=
# Carpeta del repo donde Claude Code va a trabajar.
WORKDIR=/root/MR-Abogado
# Ruta al binario claude si no está en PATH (ej: /root/.local/bin/claude)
CLAUDE_BIN=claude
# Flags de claude. acceptEdits permite editar archivos sin preguntar.
# Para autonomía total (también correr comandos): --dangerously-skip-permissions
CLAUDE_FLAGS=--permission-mode acceptEdits
# Timeout por tarea en ms (default 20 min)
TASK_TIMEOUT_MS=1200000
